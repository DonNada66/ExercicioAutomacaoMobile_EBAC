{
  "name": "projeto-automacao-mobile-wdio",
  "version": "1.0.0",
  "description": "Automação de testes mobile no WDIO Native Demo App utilizando WebdriverIO, Appium e Page Objects",
  "type": "module",
  "scripts": {
    "test": "wdio run ./wdio.conf.js",
    "test:login": "wdio run ./wdio.conf.js --spec ./test/specs/login.spec.js",
    "test:forms": "wdio run ./wdio.conf.js --spec ./test/specs/forms.spec.js",
    "test:swipe": "wdio run ./wdio.conf.js --spec ./test/specs/swipe.spec.js",
    "test:drag": "wdio run ./wdio.conf.js --spec ./test/specs/drag.spec.js"
  },
  "devDependencies": {
    "@wdio/appium-service": "^9.31.5",
    "@wdio/cli": "^9.31.5",
    "@wdio/local-runner": "^9.31.5",
    "@wdio/mocha-framework": "^9.31.5",
    "@wdio/spec-reporter": "^9.31.2",
    "appium-uiautomator2-driver": "^8.5.2"
  }
}

